<mxfile host="app.diagrams.net" modified="2026-09-18T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="qwenmemory-method" name="QwenMemory Method">
    <mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="QwenMemory: Question-Agnostic Context Compression with Reusable Memory KV" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#17233C;" vertex="1" parent="1"><mxGeometry x="270" y="18" width="1060" height="36" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;Solid&lt;/b&gt;: default path &amp;nbsp; &lt;b&gt;Dashed&lt;/b&gt;: optional/off by default &amp;nbsp; &lt;font color='#1976D2'&gt;blue = memory writer&lt;/font&gt; &amp;nbsp; &lt;font color='#2E7D32'&gt;green = QA reader&lt;/font&gt; &amp;nbsp; &lt;font color='#E65100'&gt;orange = auxiliary supervision&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFD;strokeColor=#CBD5E1;fontSize=12;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="275" y="60" width="1050" height="34" as="geometry"/></mxCell>

        <mxCell id="lane_writer" value="A. MEMORY WRITER · once per context" style="swimlane;horizontal=1;startSize=30;rounded=1;html=1;fillColor=#EAF3FF;swimlaneFillColor=#F8FBFF;strokeColor=#3B82F6;fontColor=#174EA6;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="1030" height="235" as="geometry"/></mxCell>
        <mxCell id="context" value="&lt;b&gt;Context&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;token ids [C,L]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontSize=14;" vertex="1" parent="lane_writer"><mxGeometry x="25" y="65" width="135" height="70" as="geometry"/></mxCell>
        <mxCell id="embedding" value="&lt;b&gt;Frozen token embedding&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;X ∈ ℝ&lt;sup&gt;C×L×H&lt;/sup&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;fontSize=13;" vertex="1" parent="lane_writer"><mxGeometry x="190" y="65" width="155" height="70" as="geometry"/></mxCell>
        <mxCell id="slots" value="&lt;b&gt;Learnable slots&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;S ∈ ℝ&lt;sup&gt;M×H&lt;/sup&gt;; default M=8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_writer"><mxGeometry x="190" y="145" width="155" height="60" as="geometry"/></mxCell>
        <mxCell id="backbone" value="&lt;b&gt;Frozen Qwen3 backbone + trainable LoRA&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;[context | slots] · block-causal attention&lt;/font&gt;&lt;br&gt;&lt;font color='#64748B'&gt;LoRA on q/k/v/o + gate/up/down projections&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=14;" vertex="1" parent="lane_writer"><mxGeometry x="395" y="65" width="275" height="110" as="geometry"/></mxCell>
        <mxCell id="layer_memory" value="&lt;b&gt;Per-layer memory states&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;Z ∈ ℝ&lt;sup&gt;C×N×M×H&lt;/sup&gt;&lt;/font&gt;&lt;br&gt;drives auxiliary decoders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_writer"><mxGeometry x="725" y="40" width="260" height="72" as="geometry"/></mxCell>
        <mxCell id="kv" value="&lt;b&gt;Memory-only KV cache&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;context KV discarded; slot KV retained&lt;/font&gt;&lt;br&gt;reused by every question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_writer"><mxGeometry x="725" y="127" width="260" height="72" as="geometry"/></mxCell>

        <mxCell id="lane_reader" value="B. QA READER · once per QA row, context no longer visible" style="swimlane;horizontal=1;startSize=30;rounded=1;html=1;fillColor=#EAF8EE;swimlaneFillColor=#FBFEFC;strokeColor=#22A447;fontColor=#176B2D;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="30" y="380" width="1030" height="205" as="geometry"/></mxCell>
        <mxCell id="question" value="&lt;b&gt;Question&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;[Q, Lq, H]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#22A447;strokeWidth=2;fontSize=14;" vertex="1" parent="lane_reader"><mxGeometry x="25" y="75" width="135" height="65" as="geometry"/></mxCell>
        <mxCell id="mapping" value="&lt;b&gt;qa_context_indices&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;gather owning context cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#4ADE80;fontSize=12;" vertex="1" parent="lane_reader"><mxGeometry x="188" y="38" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="resampler" value="&lt;b&gt;Question resampler&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;R latents attend [question; memory]&lt;/font&gt;&lt;br&gt;&lt;i&gt;optional, default R=0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;dashed=1;fontSize=12;" vertex="1" parent="lane_reader"><mxGeometry x="188" y="105" width="160" height="72" as="geometry"/></mxCell>
        <mxCell id="continuation" value="&lt;b&gt;Qwen continuation pass&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;memory KV ⟶ [question | readout? | answer]&lt;/font&gt;&lt;br&gt;question/answer cannot access original context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;fontSize=14;" vertex="1" parent="lane_reader"><mxGeometry x="400" y="55" width="285" height="100" as="geometry"/></mxCell>
        <mxCell id="answer" value="&lt;b&gt;Answer logits&lt;/b&gt;&lt;br&gt;&lt;font color='#64748B'&gt;[Q, S, V]&lt;/font&gt;&lt;br&gt;teacher forcing / greedy decode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;" vertex="1" parent="lane_reader"><mxGeometry x="745" y="68" width="210" height="75" as="geometry"/></mxCell>

        <mxCell id="lane_loss" value="C. TRAINING OBJECTIVES" style="swimlane;horizontal=1;startSize=30;rounded=1;html=1;fillColor=#FFF3E6;swimlaneFillColor=#FFFCF8;strokeColor=#F59E0B;fontColor=#9A4A00;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="470" height="465" as="geometry"/></mxCell>
        <mxCell id="qa_loss" value="&lt;b&gt;① QA cross-entropy&lt;/b&gt; &lt;font color='#15803D'&gt;DEFAULT ON&lt;/font&gt;&lt;br&gt;answer positions only; row-normalized&lt;br&gt;&lt;font color='#64748B'&gt;Lqa = mean CE(y, pθ)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#16A34A;strokeWidth=2;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="lane_loss"><mxGeometry x="25" y="47" width="420" height="76" as="geometry"/></mxCell>
        <mxCell id="probe_loss" value="&lt;b&gt;② Memory-only context LM&lt;/b&gt; &lt;font color='#15803D'&gt;DEFAULT ON&lt;/font&gt;&lt;br&gt;N per-layer 256-d decoders; positional queries read memory only&lt;br&gt;shared vocabulary head; sampled P≤256 positions&lt;br&gt;&lt;font color='#64748B'&gt;Lctx = (1/N) Σℓ mean CE(xₜ, head(dℓ(Zℓ,t−1)))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="lane_loss"><mxGeometry x="25" y="138" width="420" height="100" as="geometry"/></mxCell>
        <mxCell id="embedding_loss" value="&lt;b&gt;Alternative reconstruction&lt;/b&gt; &lt;font color='#64748B'&gt;select one instead of ②&lt;/font&gt;&lt;br&gt;MSE / cosine / MSE + λcos over context embeddings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;dashed=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="lane_loss"><mxGeometry x="25" y="250" width="420" height="62" as="geometry"/></mxCell>
        <mxCell id="ae_loss" value="&lt;b&gt;③ Memory-prefix AE-LM&lt;/b&gt; &lt;font color='#64748B'&gt;OPTIONAL / OFF&lt;/font&gt;&lt;br&gt;frozen Qwen decodes P(xₜ | memory, x&lt;sub&gt;&amp;lt;t&lt;/sub&gt;); tied head" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="lane_loss"><mxGeometry x="25" y="324" width="420" height="62" as="geometry"/></mxCell>
        <mxCell id="distill_loss" value="&lt;b&gt;④ Full-context → memory KL&lt;/b&gt; &lt;font color='#64748B'&gt;OPTIONAL / OFF&lt;/font&gt;&lt;br&gt;T² KL(pteacher || pstudent); requires AE-LM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;dashed=1;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="lane_loss"><mxGeometry x="25" y="398" width="420" height="52" as="geometry"/></mxCell>

        <mxCell id="total" value="Ltotal = λqa Lqa + λrec Lrec + λae Lae + λkd Lkd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#17233C;strokeColor=#17233C;fontColor=#FFFFFF;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="550" y="625" width="500" height="58" as="geometry"/></mxCell>
        <mxCell id="trainable" value="&lt;b&gt;Trainable (fp32):&lt;/b&gt; memory slots · LoRA A/B · per-layer decoders · vocabulary head/adapter · optional resampler&lt;br&gt;&lt;b&gt;Frozen (bf16):&lt;/b&gt; Qwen backbone and token embedding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="300" y="720" width="1000" height="62" as="geometry"/></mxCell>

